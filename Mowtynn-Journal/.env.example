# GEMINI_API_KEY: Primary Gemini AI API key
GEMINI_API_KEY=

# GEMINI_MODEL_NAME: Active Gemini Model (Optional - Defaults to 'gemini-3.7-flash' if unset)
GEMINI_MODEL_NAME=

# Secondary & backup Gemini API keys for automatic quota fallback (optional)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SITE_PASSWORD: The secure password required to access the application
SITE_PASSWORD=