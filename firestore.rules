rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Existing document belongs to the caller
    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Document being written belongs to the caller (prevents writing data under someone else's userId)
    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Per-record collections: every document carries a userId field
    match /trades/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /notes/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /journals/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /certificates/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }
    match /portfolioTransactions/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    // Per-user singleton documents keyed by uid
    match /settings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /portfolioSettings/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Everything else is denied by default
  }
}
