rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Okuma ve silme: kullanıcının tüm klasörü (eski "certificates" vb. klasörler dahil; "Verileri sıfırla" hepsini temizler)
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
    }

    // Yükleme: yalnızca users/{uid}/trades (işlem görselleri) ve users/{uid}/prop (hesap/sertifika fotoğrafları),
    // 5 MB altı, raster görsel (SVG gibi betik taşıyabilen türler kabul edilmez)
    match /users/{userId}/{folder}/{fileName} {
      allow create, update: if isOwner(userId)
                            && folder in ['trades', 'prop']
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|avif|heic|heif)');
    }
  }
}
